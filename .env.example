VITE_API_URL=http://localhost:3000

# Shop's fixed UTC offset in minutes (Cambodia = UTC+7 = 420), used to build
# report date presets in the shop's local day. MUST match the backend's
# SHOP_UTC_OFFSET_MINUTES, or date filters will cover a different day than the
# server reports on.
VITE_SHOP_UTC_OFFSET_MINUTES=420
